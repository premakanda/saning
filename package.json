{
  "name": "saning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "scripts": {
    "dev": "react-router dev --host localhost",
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/buildLocal.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "react-router typegen && tsc --noEmit",
    "format:check": "prettier . --check",
    "test": "node --experimental-strip-types --test scripts/validatePhone.test.mjs scripts/finalizeBuild.test.mjs scripts/validateArticles.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.18.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "image-size": "^2.1.0",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
